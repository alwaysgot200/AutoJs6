<?xml version="1.0" encoding="utf-8"?>
<!-- @mgmt-hook H9: 抽屉「已登录」弹窗 (状态头部 + 用户名/设备 ID/服务器 信息卡片, 设备 ID 可复制)。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <!-- 头部: 绿色对勾圆标 + 已登录状态 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/mgmt_bg_icon_circle_connected"
            android:padding="9dp"
            android:contentDescription="@null"
            android:src="@drawable/mgmt_ic_check_circle" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mgmt_text_logged_in"
                android:textColor="@color/text_color_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/mgmt_dialog_logged_in_subtitle"
                android:textColor="@color/mgmt_color_connected"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- 信息卡片 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/mgmt_bg_info_card"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <!-- 用户名 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/mgmt_ic_person" />

            <TextView
                android:layout_width="84dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/mgmt_text_username"
                android:textColor="@color/mgmt_color_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/mgmt_logged_username"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_color_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- 设备 ID (可复制) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/mgmt_ic_smartphone" />

            <TextView
                android:layout_width="84dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/mgmt_text_device_id"
                android:textColor="@color/mgmt_color_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/mgmt_logged_device_id"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:textColor="@color/text_color_primary"
                android:textIsSelectable="false"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/mgmt_logged_copy_id"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/mgmt_text_copy"
                android:focusable="true"
                android:padding="5dp"
                android:src="@drawable/mgmt_ic_content_copy"
                app:tint="@color/mgmt_color_brand" />

        </LinearLayout>

        <!-- 服务器地址 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/mgmt_ic_server" />

            <TextView
                android:layout_width="84dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/mgmt_text_server"
                android:textColor="@color/mgmt_color_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/mgmt_logged_server"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:singleLine="true"
                android:textColor="@color/text_color_primary"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
